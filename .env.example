# Copiá este archivo como  .env  y completá tus datos para probar localmente.
# El .env NUNCA se sube a git (está en .gitignore). En GitHub se usan Secrets.

COREFIT_EMAIL=tu-email@ejemplo.com
COREFIT_PASSWORD=tu-contrasena

# --- Opcionales (estos son los valores por defecto) ---
COREFIT_TARGET_TIME=08:00
COREFIT_DAYS_AHEAD=7
COREFIT_FIRE_TIME=08:00
COREFIT_TZ=America/Argentina/Buenos_Aires
COREFIT_BRANCH=
COREFIT_HEADLESS=true
